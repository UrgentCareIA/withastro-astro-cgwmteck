---
import Layout from '../layouts/Layout.astro';

const higgsfieldUrl = import.meta.env.PUBLIC_HIGGSFIELD_URL || 'https://higgsfield.ai';
---

<Layout
	title="Portail d'accès — Le Village Tech"
	description="Demande ton accès à la bêta gratuite du Village Tech, ou vérifie si ton compte est validé."
	bare
>
	<div class="portal pre" data-higgsfield={higgsfieldUrl}>
		<!-- ====== INTRO ====== -->
		<div class="intro" id="intro" aria-hidden="true">
			<canvas id="warp"></canvas>
			<div class="intro-core">
				<svg class="intro-logo" viewBox="0 0 100 100">
					<path class="v-l" d="M8 18 H30 L52 60 V90 Z" />
					<path class="v-r" d="M92 18 H70 L52 54 V90 Z" />
					<path class="v-s" d="M57 18 H69 L59 36 H47 Z" />
				</svg>
				<p class="intro-title">Le Village Tech</p>
				<p class="intro-sub mono" id="intro-sub">Ouverture du portail</p>
				<div class="intro-bar"><span></span></div>
			</div>
			<p class="intro-skip mono">Cliquer pour passer</p>
		</div>
		<div class="flash" id="flash" aria-hidden="true"></div>
		<div class="cursor-glow" id="glow" aria-hidden="true"></div>
		<canvas class="fx" id="fx" aria-hidden="true"></canvas>

		<!-- ====== DÉCOR ====== -->
		<div class="bg" aria-hidden="true">
			<img class="bg-city" src="/images/nuit.webp" alt="" />
			<div class="bg-floor"><div class="bg-grid"></div></div>
			<div class="searchlight s1"></div>
			<div class="searchlight s2"></div>
			<svg class="airship" viewBox="0 0 120 40">
				<ellipse cx="58" cy="16" rx="46" ry="13" />
				<path d="M100 16 L116 6 V26 Z" />
				<rect x="46" y="27" width="22" height="6" rx="2" />
				<circle class="air-light" cx="14" cy="16" r="2" />
			</svg>
			<i class="star-shoot a"></i><i class="star-shoot b"></i><i class="star-shoot c"></i>
			<canvas class="bg-particles" id="particles"></canvas>
			<div class="bg-beam"></div>
			<div class="bg-scan"></div>
			<div class="bg-vignette"></div>
		</div>

		<!-- ====== HUD HAUT ====== -->
		<header class="hud hud-top">
			<a href="/" class="hud-brand" aria-label="Retour au site du Village Tech">
				<img src="/images/logo.png" alt="" width="34" height="34" />
				<span>Le Village Tech</span>
			</a>
			<p class="hud-center mono"><span class="blink">◆</span> Portail d'accès · Bêta</p>
			<div class="hud-right mono">
				<span class="sys"><i class="dot"></i> Système en ligne</span>
				<button class="sound" id="sound" type="button" aria-pressed="false" aria-label="Activer le son">
					<span class="eq"><i></i><i></i><i></i><i></i></span> Son
				</button>
				<time id="clock">--:--:--</time>
			</div>
		</header>

		<main class="stage">
			<!-- ====== PASS ====== -->
			<section class="pass-col" aria-label="Aperçu de ton Village Pass">
				<p class="mono label">// Ton Village Pass</p>

				<div class="pass-wrap">
					<svg class="rings" viewBox="0 0 600 600" aria-hidden="true">
						<circle cx="300" cy="300" r="290" class="r1" />
						<circle cx="300" cy="300" r="250" class="r2" />
						<circle cx="300" cy="300" r="205" class="r3" />
					</svg>

					<div class="pass" id="pass" data-state="draft">
						<div class="pass-sheen"></div>
						<div class="pass-top">
							<img src="/images/logo.png" alt="" width="30" height="30" />
							<span class="mono">Village Pass</span>
							<span class="pass-tag mono">Bêta</span>
						</div>

						<div class="pass-holo" aria-hidden="true">
							<img src="/images/logo.png" alt="" />
							<span class="holo-scan"></span>
							<span class="holo-base"></span>
						</div>

						<div class="pass-id">
							<div class="avatar"><span id="p-initials">?</span></div>
							<div class="pass-who">
								<p class="pass-name" id="p-name">Ton nom ici</p>
								<p class="pass-role" id="p-role">Entrepreneur</p>
								<p class="pass-handle mono" id="p-handle">@pseudo-higgsfield</p>
							</div>
						</div>

						<div class="pass-chips">
							<span class="chip" id="p-stage">Stade —</span>
							<span class="chip" id="p-sector">Secteur —</span>
						</div>

						<div class="pass-bottom">
							<div>
								<p class="mono tiny">Statut</p>
								<p class="status" id="p-status"><i></i><span>Brouillon</span></p>
								<p class="mono tiny code" id="p-code">VT-····-····</p>
							</div>
							<svg class="qr" id="p-qr" viewBox="0 0 11 11" aria-hidden="true"></svg>
						</div>
					</div>
				</div>
				<p class="pass-hint">Ton pass se génère en direct pendant que tu remplis le formulaire.</p>
			</section>

			<!-- ====== CONSOLE ====== -->
			<section class="console" aria-label="Accès au Village">
				<span class="corner tl"></span><span class="corner tr"></span>
				<span class="corner bl"></span><span class="corner br"></span>
				<span class="run run-t" aria-hidden="true"></span>
				<span class="run run-b" aria-hidden="true"></span>
				<span class="wipe" aria-hidden="true"></span>

				<div class="boot mono" id="boot" aria-hidden="true"></div>

				<div class="tabs" role="tablist">
					<button role="tab" id="tab-req" aria-selected="true" aria-controls="panel-req">Demander l'accès</button>
					<button role="tab" id="tab-log" aria-selected="false" aria-controls="panel-log">Déjà inscrit ?</button>
					<span class="tab-ink" aria-hidden="true"></span>
				</div>

				<!-- ---------- DEMANDE D'ACCÈS ---------- -->
				<div class="panel" id="panel-req" role="tabpanel" aria-labelledby="tab-req">
					<ol class="steps mono" aria-label="Étapes">
						<li class="on"><b>01</b> Identité</li>
						<li><b>02</b> Projet</li>
						<li><b>03</b> Validation</li>
					</ol>
					<div class="progress"><span id="progress"></span></div>

					<form id="beta-form" novalidate>
						<fieldset data-step="0" class="step-set on">
							<legend class="sr">Identité</legend>
							<div class="row">
								<div class="field">
									<input id="f-first" name="first_name" required autocomplete="given-name" maxlength="80" placeholder=" " />
									<label for="f-first">Prénom</label>
								</div>
								<div class="field">
									<input id="f-last" name="last_name" required autocomplete="family-name" maxlength="80" placeholder=" " />
									<label for="f-last">Nom</label>
								</div>
							</div>
							<div class="field">
								<input id="f-email" name="email" type="email" required autocomplete="email" maxlength="200" placeholder=" " />
								<label for="f-email">Email</label>
								<small>C'est là qu'on t'écrit quand ton compte est activé.</small>
							</div>
							<div class="field">
								<input id="f-handle" name="higgsfield_username" required maxlength="80" placeholder=" " autocapitalize="off" spellcheck="false" />
								<label for="f-handle">Pseudo Higgsfield</label>
								<small>
									C'est ce compte qu'on active. Pas encore de compte ?
									<a href="https://higgsfield.ai" target="_blank" rel="noopener">Crée-le ici</a>, c'est gratuit.
								</small>
							</div>
						</fieldset>

						<fieldset data-step="1" class="step-set">
							<legend class="sr">Projet</legend>
							<div class="field">
								<input id="f-company" name="company" maxlength="120" autocomplete="organization" placeholder=" " />
								<label for="f-company">Projet / entreprise <em>(facultatif)</em></label>
							</div>
							<p class="mono q">Où en es-tu ?</p>
							<div class="stages" role="radiogroup" aria-label="Où en es-tu ?">
								<label class="stage-opt"><input type="radio" name="stage" value="idee" required /><span><b>Idée</b>J'ai une idée</span></label>
								<label class="stage-opt"><input type="radio" name="stage" value="lancement" /><span><b>Lancement</b>Je démarre</span></label>
								<label class="stage-opt"><input type="radio" name="stage" value="activite" /><span><b>Activité</b>Ça tourne</span></label>
								<label class="stage-opt"><input type="radio" name="stage" value="croissance" /><span><b>Croissance</b>Je recrute / lève</span></label>
								<label class="stage-opt"><input type="radio" name="stage" value="autre" /><span><b>Autre</b>Freelance, mentor…</span></label>
							</div>
							<div class="field">
								<input id="f-sector" name="sector" maxlength="80" placeholder=" " />
								<label for="f-sector">Secteur <em>(tech, commerce, santé…)</em></label>
							</div>
						</fieldset>

						<fieldset data-step="2" class="step-set">
							<legend class="sr">Validation</legend>
							<div class="field">
								<textarea id="f-motivation" name="motivation" required rows="4" maxlength="1000" placeholder=" "></textarea>
								<label for="f-motivation">Qu'est-ce que tu viens chercher dans le Village ?</label>
								<small class="count mono"><span id="count">0</span> / 1000</small>
							</div>
							<div class="field">
								<input id="f-ref" name="referral" maxlength="120" placeholder=" " />
								<label for="f-ref">Comment tu nous as connus ? <em>(facultatif)</em></label>
							</div>

							<div class="hp" aria-hidden="true">
								<input name="website" tabindex="-1" autocomplete="off" />
							</div>

							<label class="consent">
								<input type="checkbox" name="consent" required />
								<span class="box" aria-hidden="true"></span>
								<span>
									J'accepte que Le Village Tech utilise ces informations pour gérer mon accès à la bêta
									et me contacter à ce sujet. <a href="/confidentialite">En savoir plus</a>
								</span>
							</label>
						</fieldset>

						<p class="error mono" id="form-error" role="alert" hidden></p>

						<div class="actions">
							<button type="button" class="btn-back" id="back" hidden>← Retour</button>
							<button type="button" class="btn-go" id="next">Continuer <span>→</span></button>
							<button type="submit" class="btn-go" id="submit" hidden>Transmettre ma demande <span>⟶</span></button>
						</div>
					</form>

					<!-- transmission -->
					<div class="transmit" id="transmit" hidden>
						<div class="orb"></div>
						<p class="mono" id="transmit-line">Chiffrement de la demande…</p>
						<div class="progress"><span id="transmit-bar"></span></div>
					</div>

					<!-- succès -->
					<div class="done" id="done" hidden tabindex="-1">
						<p class="mono label ok">// Demande enregistrée</p>
						<h2>Bienvenue sur la liste, <span id="done-name"></span>.</h2>
						<p>
							On vérifie ton profil et on active ton compte sur Higgsfield. Tu recevras un mail à
							<strong id="done-email"></strong> dès que la porte est ouverte.
						</p>
						<button class="btn-ghost-hud" type="button" data-goto="log">Vérifier mon statut plus tard →</button>
					</div>
				</div>

				<!-- ---------- DÉJÀ INSCRIT ---------- -->
				<div class="panel" id="panel-log" role="tabpanel" aria-labelledby="tab-log" hidden>
					<p class="log-intro">
						Entre l'email et le pseudo Higgsfield de ta demande pour savoir où en est ton accès.
					</p>
					<form id="check-form" novalidate>
						<div class="field">
							<input id="c-email" name="email" type="email" required autocomplete="email" placeholder=" " />
							<label for="c-email">Email</label>
						</div>
						<div class="field">
							<input id="c-handle" name="handle" required placeholder=" " autocapitalize="off" spellcheck="false" />
							<label for="c-handle">Pseudo Higgsfield</label>
						</div>
						<p class="error mono" id="check-error" role="alert" hidden></p>
						<div class="actions">
							<button type="submit" class="btn-go" id="check-btn">Vérifier mon accès <span>→</span></button>
						</div>
					</form>

					<div class="result" id="result" hidden aria-live="polite"></div>

					<div class="enter">
						<p class="mono tiny">Compte déjà validé</p>
						<a class="btn-enter" href={higgsfieldUrl} target="_blank" rel="noopener">
							<span>Entrer dans le Village</span><b>↗</b>
						</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="hud hud-bottom mono">
			<span>Bêta gratuite · validation manuelle par l'équipe</span>
			<a href="/confidentialite">Confidentialité</a>
			<a href="/">← Retour au site</a>
		</footer>
	</div>
</Layout>

<script is:inline>
	setTimeout(function () {
		var p = document.querySelector('.portal');
		if (p) p.classList.remove('pre');
		var i = document.getElementById('intro');
		if (i) i.remove();
	}, 7000);
</script>

<script>
	const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
	const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
	const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
	const emit = (name: string, detail?: unknown) => document.dispatchEvent(new CustomEvent(name, { detail }));

	/* ---------- horloge ---------- */
	const clock = $('clock');
	const tick = () => (clock.textContent = new Date().toLocaleTimeString('fr-FR'));
	tick();
	setInterval(tick, 1000);

	/* ---------- séquence de démarrage ---------- */
	(async () => {
		const boot = $('boot');
		const lines = ['> connexion au Campus…', '> portail bêta ouvert', '> identifie-toi'];
		if (reduced) {
			boot.textContent = lines.join('   ');
			return;
		}
		for (const l of lines) {
			const p = document.createElement('p');
			boot.appendChild(p);
			for (const ch of l) {
				p.textContent += ch;
				await sleep(18);
			}
			p.insertAdjacentHTML('beforeend', ' <b>OK</b>');
			await sleep(120);
		}
	})();

	/* ---------- pass : inclinaison 3D ---------- */
	const pass = $('pass');
	if (!reduced && matchMedia('(hover: hover)').matches) {
		const wrap = pass.parentElement as HTMLElement;
		wrap.addEventListener('pointermove', (e) => {
			const r = pass.getBoundingClientRect();
			const x = (e.clientX - r.left) / r.width - 0.5;
			const y = (e.clientY - r.top) / r.height - 0.5;
			pass.style.setProperty('--rx', `${(-y * 14).toFixed(2)}deg`);
			pass.style.setProperty('--ry', `${(x * 18).toFixed(2)}deg`);
			pass.style.setProperty('--mx', `${((x + 0.5) * 100).toFixed(1)}%`);
			pass.style.setProperty('--my', `${((y + 0.5) * 100).toFixed(1)}%`);
		});
		wrap.addEventListener('pointerleave', () => {
			pass.style.setProperty('--rx', '0deg');
			pass.style.setProperty('--ry', '0deg');
		});
	}

	/* ---------- pass : rendu en direct ---------- */
	const form = $<HTMLFormElement>('beta-form');
	const STAGES: Record<string, string> = {
		idee: 'Idée', lancement: 'Lancement', activite: 'En activité', croissance: 'Croissance', autre: 'Autre',
	};
	const hash = (s: string) => {
		let h = 2166136261;
		for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
		return h >>> 0;
	};
	const drawQR = (seed: number) => {
		const svg = $('p-qr') as unknown as SVGElement;
		let out = '';
		let s = seed || 1;
		const finder = (x: number, y: number) =>
			`<rect x="${x}" y="${y}" width="3" height="3" fill="none" stroke="currentColor" stroke-width=".6"/><rect x="${x + 1}" y="${y + 1}" width="1" height="1"/>`;
		for (let y = 0; y < 11; y++)
			for (let x = 0; x < 11; x++) {
				const inFinder = (x < 4 && y < 4) || (x > 6 && y < 4) || (x < 4 && y > 6);
				s = (Math.imul(s, 1103515245) + 12345) >>> 0;
				if (!inFinder && s % 100 < 46) out += `<rect x="${x}" y="${y}" width="1" height="1"/>`;
			}
		svg.innerHTML = finder(0, 0) + finder(8, 0) + finder(0, 8) + out;
	};
	const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&@$<>/';
	const scrambles = new WeakMap<HTMLElement, number>();
	const scramble = (el: HTMLElement, text: string) => {
		if (el.dataset.t === text) return;
		el.dataset.t = text;
		if (reduced) { el.textContent = text; return; }
		cancelAnimationFrame(scrambles.get(el) ?? 0);
		const start = performance.now(), dur = 380;
		const frame = (t: number) => {
			const k = Math.min(1, (t - start) / dur);
			const fixed = Math.floor(text.length * k);
			let out = text.slice(0, fixed);
			for (let i = fixed; i < text.length; i++)
				out += text[i] === ' ' ? ' ' : GLYPHS[(Math.random() * GLYPHS.length) | 0];
			el.textContent = out;
			if (k < 1) scrambles.set(el, requestAnimationFrame(frame));
		};
		scrambles.set(el, requestAnimationFrame(frame));
	};
	const val = (n: string) => String(new FormData(form).get(n) ?? '').trim();
	const render = () => {
		const first = val('first_name'), last = val('last_name');
		const company = val('company'), sector = val('sector'), email = val('email');
		const handle = val('higgsfield_username').replace(/^@/, '');
		const stage = val('stage');
		scramble($('p-name'), [first, last].filter(Boolean).join(' ') || 'Ton nom ici');
		$('p-initials').textContent = ((first[0] ?? '') + (last[0] ?? '')).toUpperCase() || '?';
		$('p-role').textContent = company ? `Fondateur · ${company}` : 'Entrepreneur';
		$('p-handle').textContent = '@' + (handle || 'pseudo-higgsfield');
		scramble($('p-stage'), STAGES[stage] ?? 'Stade —');
		$('p-sector').textContent = sector || 'Secteur —';
		const h = hash(email.toLowerCase() + handle.toLowerCase());
		const hex = h.toString(16).toUpperCase().padStart(8, '0');
		scramble($('p-code'), email ? `VT-${hex.slice(0, 4)}-${hex.slice(4)}` : 'VT-····-····');
		drawQR(email ? h : 7);
		$('count').textContent = String(val('motivation').length);
	};
	form.addEventListener('input', render);
	render();

	const setStatus = (state: 'draft' | 'pending' | 'valide' | 'refuse', label: string) => {
		pass.dataset.state = state;
		emit('vt:status', state);
		($('p-status').querySelector('span') as HTMLElement).textContent = label;
	};

	/* ---------- onglets ---------- */
	const tabs = { req: $('tab-req'), log: $('tab-log') };
	const panels = { req: $('panel-req'), log: $('panel-log') };
	const show = (k: 'req' | 'log') => {
		(Object.keys(tabs) as ('req' | 'log')[]).forEach((t) => {
			tabs[t].setAttribute('aria-selected', String(t === k));
			panels[t].hidden = t !== k;
		});
		const tabsEl = document.querySelector('.tabs') as HTMLElement;
		if (tabsEl.dataset.active !== k) emit('vt:tab', k);
		tabsEl.dataset.active = k;
	};
	tabs.req.addEventListener('click', () => show('req'));
	tabs.log.addEventListener('click', () => show('log'));
	document.querySelectorAll<HTMLElement>('[data-goto="log"]').forEach((b) => b.addEventListener('click', () => show('log')));
	if (location.hash === '#connexion') show('log');

	/* ---------- étapes ---------- */
	const sets = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.step-set'));
	const stepLis = Array.from(document.querySelectorAll('.steps li'));
	const errorEl = $('form-error');
	const btnNext = $<HTMLButtonElement>('next'), btnBack = $<HTMLButtonElement>('back'), btnSubmit = $<HTMLButtonElement>('submit');
	let step = 0;

	const showError = (el: HTMLElement, msg: string) => { el.textContent = msg; el.hidden = false; emit('vt:error', el); };
	const goStep = (n: number) => {
		if (n !== step) emit('vt:step', n);
		step = n;
		sets.forEach((s, i) => s.classList.toggle('on', i === n));
		stepLis.forEach((li, i) => { li.classList.toggle('on', i === n); li.classList.toggle('done', i < n); });
		$('progress').style.width = `${((n + 1) / sets.length) * 100}%`;
		btnBack.hidden = n === 0;
		btnNext.hidden = n === sets.length - 1;
		btnSubmit.hidden = n !== sets.length - 1;
		errorEl.hidden = true;
		(sets[n].querySelector('input:not([type=radio]),textarea') as HTMLElement | null)?.focus({ preventScroll: true });
	};
	const validStep = (n: number) => {
		const fields = Array.from(sets[n].querySelectorAll<HTMLInputElement>('input,textarea,select'));
		const bad = fields.find((f) => !f.checkValidity());
		if (!bad) return true;
		bad.focus();
		const msg =
			bad.type === 'email' && bad.value ? 'Cet email ne semble pas valide.'
			: bad.type === 'checkbox' ? 'Coche la case de consentement pour continuer.'
			: bad.type === 'radio' ? 'Choisis où tu en es.'
			: 'Il manque un champ obligatoire.';
		showError(errorEl, '! ' + msg);
		sets[n].classList.remove('shake');
		void sets[n].offsetWidth;
		sets[n].classList.add('shake');
		return false;
	};
	btnNext.addEventListener('click', () => validStep(step) && goStep(step + 1));
	btnBack.addEventListener('click', () => goStep(step - 1));
	form.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && step < sets.length - 1 && (e.target as HTMLElement).tagName === 'INPUT') {
			e.preventDefault();
			btnNext.click();
		}
	});
	goStep(0);

	/* ---------- envoi ---------- */
	const api = (path: string, body: unknown, prefer?: string) =>
		fetch(`${SUPABASE_URL}/rest/v1/${path}`, {
			method: 'POST',
			headers: {
				apikey: SUPABASE_KEY,
				Authorization: `Bearer ${SUPABASE_KEY}`,
				'Content-Type': 'application/json',
				...(prefer ? { Prefer: prefer } : {}),
			},
			body: JSON.stringify(body),
		});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!validStep(step)) return;
		const data = new FormData(form);
		if (data.get('website')) return;

		const str = (k: string) => String(data.get(k) ?? '').trim() || null;
		const payload = {
			first_name: str('first_name'),
			last_name: str('last_name'),
			email: str('email')?.toLowerCase(),
			higgsfield_username: str('higgsfield_username')?.replace(/^@/, ''),
			company: str('company'),
			stage: str('stage'),
			sector: str('sector'),
			motivation: str('motivation'),
			referral: str('referral'),
		};

		if (!SUPABASE_URL || !SUPABASE_KEY) {
			showError(errorEl, '! Le formulaire n’est pas encore branché (configuration Supabase manquante).');
			return;
		}

		const transmit = $('transmit'), line = $('transmit-line'), bar = $('transmit-bar');
		form.hidden = true;
		transmit.hidden = false;
		emit('vt:transmit');
		const anim = (async () => {
			const msgs = ['Chiffrement de la demande…', 'Transmission au Campus…', 'Enregistrement du pass…'];
			for (let i = 0; i < msgs.length; i++) {
				line.textContent = msgs[i];
				bar.style.width = `${((i + 1) / msgs.length) * 100}%`;
				await sleep(reduced ? 150 : 650);
			}
		})();

		try {
			const [res] = await Promise.all([api('beta_requests', payload, 'return=minimal'), anim]);
			if (res.status === 409) {
				transmit.hidden = true;
				form.hidden = false;
				showError(errorEl, '! Cette adresse a déjà fait une demande. Vérifie ton statut dans « Déjà inscrit ? ».');
				return;
			}
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			transmit.hidden = true;
			$('done-name').textContent = payload.first_name ?? '';
			$('done-email').textContent = payload.email ?? '';
			$('done').hidden = false;
			$('done').focus();
			document.querySelector('.steps')?.classList.add('complete');
			$('progress').style.width = '100%';
			setStatus('pending', 'En attente de validation');
			emit('vt:success');
			($('c-email') as HTMLInputElement).value = payload.email ?? '';
			($('c-handle') as HTMLInputElement).value = payload.higgsfield_username ?? '';
		} catch (err) {
			console.error(err);
			transmit.hidden = true;
			form.hidden = false;
			showError(errorEl, '! L’envoi a échoué. Vérifie ta connexion et réessaie.');
		}
	});

	/* ---------- vérification du statut ---------- */
	const checkForm = $<HTMLFormElement>('check-form');
	const result = $('result');
	const higgsfield = (document.querySelector('.portal') as HTMLElement).dataset.higgsfield ?? '#';
	checkForm.addEventListener('submit', async (e) => {
		e.preventDefault();
		const err = $('check-error');
		err.hidden = true;
		const bad = Array.from(checkForm.querySelectorAll('input')).find((i) => !i.checkValidity());
		if (bad) { bad.focus(); showError(err, '! Renseigne ton email et ton pseudo Higgsfield.'); return; }
		if (!SUPABASE_URL || !SUPABASE_KEY) { showError(err, '! Vérification indisponible (configuration Supabase manquante).'); return; }

		const btn = $<HTMLButtonElement>('check-btn');
		btn.disabled = true;
		btn.firstChild!.textContent = 'Analyse… ';
		result.hidden = true;
		try {
			const fd = new FormData(checkForm);
			const [res] = await Promise.all([
				api('rpc/beta_status', { p_email: String(fd.get('email')), p_pseudo: String(fd.get('handle')) }),
				sleep(reduced ? 0 : 700),
			]);
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const status: string = await res.json();
			const views: Record<string, [string, string, string]> = {
				valide: ['ok', 'Accès ouvert', 'Ton compte est activé sur Higgsfield. Bienvenue au Village !'],
				en_attente: ['wait', 'En attente de validation', 'On a bien ta demande, on la traite à la main. Tu recevras un mail.'],
				refuse: ['no', 'Demande non retenue', 'On ne peut pas t’ouvrir l’accès pour cette bêta. Écris-nous si tu penses que c’est une erreur.'],
				introuvable: ['none', 'Aucune demande trouvée', 'Vérifie l’email et le pseudo, ou fais une demande dans l’onglet « Demander l’accès ».'],
			};
			const [cls, title, text] = views[status] ?? views.introuvable;
			result.className = `result ${cls}`;
			result.innerHTML = `<p class="mono tiny">Statut</p><p class="r-title"><i></i></p><p class="r-text"></p>`;
			(result.querySelector('.r-title') as HTMLElement).append(title);
			(result.querySelector('.r-text') as HTMLElement).textContent = text;
			if (status === 'valide') {
				const a = document.createElement('a');
				a.className = 'btn-enter';
				a.href = higgsfield; a.target = '_blank'; a.rel = 'noopener';
				a.innerHTML = '<span>Entrer dans le Village</span><b>↗</b>';
				result.appendChild(a);
				setStatus('valide', 'Accès validé');
			} else if (status === 'en_attente') setStatus('pending', 'En attente de validation');
			else if (status === 'refuse') setStatus('refuse', 'Non retenue');
			(document.querySelector('.enter') as HTMLElement).hidden = status === 'valide';
			result.hidden = false;
		} catch (e2) {
			console.error(e2);
			showError(err, '! Vérification impossible pour le moment. Réessaie dans un instant.');
		} finally {
			btn.disabled = false;
			btn.firstChild!.textContent = 'Vérifier mon accès ';
		}
	});
</script>

<script>
	/* =========================================================
	   EFFETS IMMERSIFS : intro, décor, particules, sons
	   ========================================================= */
	const reducedFx = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
	const portal = document.querySelector('.portal') as HTMLElement;
	const byId = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
	const store = {
		get: (k: string) => { try { return sessionStorage.getItem(k) ?? localStorage.getItem(k); } catch { return null; } },
		setSession: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch {} },
		setLocal: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} },
	};

	/* ---------------- SON (WebAudio, coupé par défaut) ---------------- */
	let actx: AudioContext | null = null;
	let soundOn = store.get('vt-sound') === '1';
	const soundBtn = byId<HTMLButtonElement>('sound');
	const syncSoundBtn = () => {
		soundBtn.setAttribute('aria-pressed', String(soundOn));
		soundBtn.setAttribute('aria-label', soundOn ? 'Couper le son' : 'Activer le son');
		soundBtn.classList.toggle('on', soundOn);
	};
	const ensureAudio = () => {
		if (!actx) {
			const AC = window.AudioContext || (window as any).webkitAudioContext;
			if (!AC) return null;
			actx = new AC();
		}
		if (actx.state === 'suspended') actx.resume();
		return actx;
	};
	const tone = (freq: number, dur: number, type: OscillatorType = 'sine', vol = 0.05, delay = 0, slideTo?: number) => {
		if (!soundOn) return;
		const a = ensureAudio();
		if (!a) return;
		const t = a.currentTime + delay;
		const o = a.createOscillator(), g = a.createGain();
		o.type = type;
		o.frequency.setValueAtTime(freq, t);
		if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, t + dur);
		g.gain.setValueAtTime(0.0001, t);
		g.gain.exponentialRampToValueAtTime(vol, t + 0.012);
		g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
		o.connect(g).connect(a.destination);
		o.start(t);
		o.stop(t + dur + 0.02);
	};
	const sfx = {
		tick: () => tone(1900 + Math.random() * 500, 0.04, 'square', 0.012),
		hover: () => tone(1200, 0.05, 'sine', 0.015),
		whoosh: () => { tone(300, 0.35, 'sawtooth', 0.02, 0, 1400); tone(600, 0.3, 'sine', 0.03, 0.05, 2000); },
		tab: () => tone(880, 0.12, 'triangle', 0.04, 0, 1320),
		error: () => { tone(160, 0.18, 'square', 0.035); tone(120, 0.22, 'square', 0.035, 0.12); },
		transmit: () => { for (let i = 0; i < 6; i++) tone(500 + i * 140, 0.09, 'triangle', 0.025, i * 0.22); },
		success: () => [523, 659, 784, 1047, 1319].forEach((f, i) => tone(f, 0.5, 'sine', 0.05, i * 0.09)),
		granted: () => { [392, 523, 659, 784, 1047, 1568].forEach((f, i) => tone(f, 0.7, 'triangle', 0.045, i * 0.07)); tone(80, 0.8, 'sine', 0.08, 0, 160); },
		boot: () => { tone(110, 1.6, 'sawtooth', 0.025, 0, 880); tone(55, 1.8, 'sine', 0.06, 0, 220); },
		warp: () => { tone(200, 0.6, 'sawtooth', 0.03, 0, 3000); tone(60, 0.9, 'sine', 0.09, 0, 30); },
	};
	syncSoundBtn();
	soundBtn.addEventListener('click', () => {
		soundOn = !soundOn;
		store.setLocal('vt-sound', soundOn ? '1' : '0');
		syncSoundBtn();
		if (soundOn) { ensureAudio(); sfx.tab(); }
	});

	/* ---------------- CANVAS FX (bursts au premier plan) ---------------- */
	type P = { x: number; y: number; vx: number; vy: number; life: number; max: number; r: number; c: string; g?: number };
	const fxCanvas = byId<HTMLCanvasElement>('fx');
	const fctx = fxCanvas.getContext('2d')!;
	const bgCanvas = byId<HTMLCanvasElement>('particles');
	const bctx = bgCanvas.getContext('2d')!;
	const dpr = Math.min(window.devicePixelRatio || 1, 2);
	let W = innerWidth, H = innerHeight;
	const sizeCanvas = (c: HTMLCanvasElement, ctx: CanvasRenderingContext2D, w: number, h: number) => {
		c.width = w * dpr; c.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
	};
	const resize = () => {
		W = innerWidth; H = innerHeight;
		sizeCanvas(fxCanvas, fctx, W, H);
		sizeCanvas(bgCanvas, bctx, bgCanvas.clientWidth, bgCanvas.clientHeight);
	};
	resize();
	addEventListener('resize', resize);

	const sparks: P[] = [];
	const burst = (x: number, y: number, n = 30, colors = ['#8ec5ff', '#3b82f6', '#ffffff'], speed = 6, gravity = 0) => {
		if (reducedFx) return;
		for (let i = 0; i < n; i++) {
			const a = Math.random() * Math.PI * 2, v = Math.random() * speed + 0.5;
			sparks.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: 0, max: 40 + Math.random() * 40,
				r: Math.random() * 2.2 + 0.6, c: colors[(Math.random() * colors.length) | 0], g: gravity });
		}
	};
	const confetti = (colors: string[]) => {
		if (reducedFx) return;
		for (let i = 0; i < 140; i++)
			sparks.push({ x: Math.random() * W, y: -10 - Math.random() * H * 0.4, vx: (Math.random() - 0.5) * 2,
				vy: Math.random() * 3 + 2, life: 0, max: 160 + Math.random() * 80, r: Math.random() * 2.5 + 1,
				c: colors[(Math.random() * colors.length) | 0], g: 0.02 });
	};
	const centerOf = (el: Element) => { const r = el.getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2]; };

	/* particules d'ambiance : montent, fuient la souris, se relient près du curseur */
	let mx = -9999, my = -9999;
	const amb = Array.from({ length: reducedFx ? 0 : Math.min(110, Math.round(innerWidth / 12)) }, () => ({
		x: Math.random() * innerWidth, y: Math.random() * innerHeight, vx: 0, vy: 0,
		s: Math.random() * 0.4 + 0.08, r: Math.random() * 1.6 + 0.3, a: Math.random() * 0.6 + 0.2,
	}));
	const loop = () => {
		if (!document.hidden) {
			const bw = bgCanvas.clientWidth, bh = bgCanvas.clientHeight;
			bctx.clearRect(0, 0, bw, bh);
			const near: typeof amb = [];
			for (const p of amb) {
				const dx = p.x - mx, dy = p.y - my, d2 = dx * dx + dy * dy;
				if (d2 < 140 * 140) {
					const f = (1 - Math.sqrt(d2) / 140) * 0.6;
					p.vx += (dx / (Math.sqrt(d2) + 0.1)) * f;
					p.vy += (dy / (Math.sqrt(d2) + 0.1)) * f;
					near.push(p);
				}
				p.vx *= 0.94; p.vy *= 0.94;
				p.x += p.vx; p.y += p.vy - p.s;
				if (p.y < -5) { p.y = bh + 5; p.x = Math.random() * bw; }
				if (p.x < -5) p.x = bw + 5; else if (p.x > bw + 5) p.x = -5;
				bctx.beginPath();
				bctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
				bctx.fillStyle = `rgba(142,197,255,${p.a})`;
				bctx.fill();
			}
			bctx.lineWidth = 0.6;
			for (let i = 0; i < near.length; i++)
				for (let j = i + 1; j < near.length; j++) {
					const a = near[i], b = near[j], d = Math.hypot(a.x - b.x, a.y - b.y);
					if (d < 90) {
						bctx.strokeStyle = `rgba(142,197,255,${(1 - d / 90) * 0.5})`;
						bctx.beginPath(); bctx.moveTo(a.x, a.y); bctx.lineTo(b.x, b.y); bctx.stroke();
					}
				}

			fctx.clearRect(0, 0, W, H);
			fctx.globalCompositeOperation = 'lighter';
			for (let i = sparks.length - 1; i >= 0; i--) {
				const p = sparks[i];
				p.life++;
				p.vx *= 0.96; p.vy = p.vy * 0.96 + (p.g ?? 0) * 8;
				p.x += p.vx; p.y += p.vy;
				const k = 1 - p.life / p.max;
				if (k <= 0) { sparks.splice(i, 1); continue; }
				fctx.globalAlpha = k;
				fctx.fillStyle = p.c;
				fctx.beginPath(); fctx.arc(p.x, p.y, p.r * (0.5 + k), 0, Math.PI * 2); fctx.fill();
			}
			fctx.globalAlpha = 1;
			fctx.globalCompositeOperation = 'source-over';
		}
		requestAnimationFrame(loop);
	};
	requestAnimationFrame(loop);

	/* ---------------- INTRO : logo + saut en hyperespace ---------------- */
	const intro = byId('intro');
	const reveal = () => {
		portal.classList.remove('pre');
		portal.classList.add('ready');
	};
	const runIntro = async () => {
		const seen = store.get('vt-intro') === '1';
		if (reducedFx || seen) {
			intro.remove();
			requestAnimationFrame(reveal);
			return;
		}
		store.setSession('vt-intro', '1');
		const c = byId<HTMLCanvasElement>('warp');
		const ctx = c.getContext('2d')!;
		sizeCanvas(c, ctx, innerWidth, innerHeight);
		const cx = innerWidth / 2, cy = innerHeight / 2;
		const stars = Array.from({ length: 500 }, () => ({ x: (Math.random() - 0.5) * innerWidth * 2, y: (Math.random() - 0.5) * innerHeight * 2, z: Math.random() * 1000 + 1 }));
		let speed = 2, running = true, skipped = false;
		const draw = () => {
			if (!running) return;
			ctx.fillStyle = 'rgba(2,5,12,0.35)';
			ctx.fillRect(0, 0, innerWidth, innerHeight);
			for (const s of stars) {
				const pz = s.z;
				s.z -= speed;
				if (s.z < 1) { s.z = 1000; continue; }
				const k = 300 / s.z, pk = 300 / pz;
				const x = cx + s.x * k, y = cy + s.y * k, px = cx + s.x * pk, py = cy + s.y * pk;
				ctx.strokeStyle = `rgba(${150 + (speed > 20 ? 105 : 0)},${200},255,${Math.min(1, 1.2 - s.z / 1000)})`;
				ctx.lineWidth = Math.max(0.5, 2.2 - s.z / 500);
				ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(x, y); ctx.stroke();
			}
			requestAnimationFrame(draw);
		};
		draw();
		const skip = () => { skipped = true; };
		intro.addEventListener('click', skip);
		addEventListener('keydown', skip, { once: true });
		const sub = byId('intro-sub');
		const steps = ['Ouverture du portail', 'Synchronisation du Campus', 'Accès autorisé'];
		sfx.boot();
		for (let i = 0; i < steps.length && !skipped; i++) {
			sub.textContent = steps[i];
			for (let t = 0; t < 700 && !skipped; t += 50) { speed = Math.min(speed + 0.25, 10); await wait(50); }
		}
		intro.classList.add('warp');
		sfx.warp();
		for (let t = 0; t < 520; t += 16) { speed = Math.min(speed * 1.12 + 1, 90); await wait(16); }
		byId('flash').classList.add('on');
		intro.classList.add('out');
		reveal();
		await wait(700);
		running = false;
		intro.remove();
		byId('flash').classList.remove('on');
	};
	runIntro();

	/* ---------------- PARALLAXE + HALO DU CURSEUR ---------------- */
	if (!reducedFx && finePointer) {
		const glow = byId('glow');
		let tx = 0, ty = 0, cx = 0, cy = 0, gx = innerWidth / 2, gy = innerHeight / 2, ggx = gx, ggy = gy;
		addEventListener('pointermove', (e) => {
			mx = e.clientX; my = e.clientY;
			tx = e.clientX / innerWidth - 0.5; ty = e.clientY / innerHeight - 0.5;
			gx = e.clientX; gy = e.clientY;
			glow.classList.add('on');
		});
		document.addEventListener('pointerleave', () => { mx = my = -9999; glow.classList.remove('on'); });
		const follow = () => {
			cx += (tx - cx) * 0.06; cy += (ty - cy) * 0.06;
			ggx += (gx - ggx) * 0.18; ggy += (gy - ggy) * 0.18;
			portal.style.setProperty('--px', cx.toFixed(4));
			portal.style.setProperty('--py', cy.toFixed(4));
			glow.style.transform = `translate(${ggx}px, ${ggy}px)`;
			requestAnimationFrame(follow);
		};
		follow();

		/* boutons magnétiques */
		document.querySelectorAll<HTMLElement>('.btn-go, .btn-enter, .tabs button, .sound').forEach((b) => {
			b.addEventListener('pointermove', (e) => {
				const r = b.getBoundingClientRect();
				b.style.translate = `${((e.clientX - r.left) / r.width - 0.5) * 10}px ${((e.clientY - r.top) / r.height - 0.5) * 8}px`;
			});
			b.addEventListener('pointerleave', () => (b.style.translate = ''));
		});
	} else {
		addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; });
	}

	/* ---------------- RÉACTIONS AUX ACTIONS ---------------- */
	const consoleEl = document.querySelector('.console') as HTMLElement;
	const pass = byId('pass');
	const restart = (el: Element, cls: string) => { el.classList.remove(cls); void (el as HTMLElement).offsetWidth; el.classList.add(cls); };

	// étincelles en tapant
	const measure = document.createElement('canvas').getContext('2d')!;
	document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field input, .field textarea').forEach((f) => {
		f.addEventListener('input', (e) => {
			if ((e as InputEvent).inputType?.startsWith('delete')) return;
			sfx.tick();
			if (reducedFx) return;
			const r = f.getBoundingClientRect();
			const cs = getComputedStyle(f);
			measure.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
			let x: number, y: number;
			if (f.tagName === 'TEXTAREA') { x = r.left + r.width - 30; y = r.bottom - 20; }
			else { x = Math.min(r.left + 16 + measure.measureText(f.value).width, r.right - 12); y = r.top + r.height * 0.68; }
			burst(x, y, 6, ['#8ec5ff', '#ffffff'], 2.5);
		});
		f.addEventListener('focus', () => restart(f.closest('.field')!, 'scanin'));
	});
	document.querySelectorAll('.stage-opt input, .consent input').forEach((i) =>
		i.addEventListener('change', () => {
			sfx.tab();
			const [x, y] = centerOf((i as HTMLElement).nextElementSibling!);
			burst(x, y, 18, ['#8ec5ff', '#3b82f6'], 3.5);
		}),
	);
	document.querySelectorAll('.stage-opt, .tabs button, .btn-go').forEach((el) => el.addEventListener('pointerenter', sfx.hover));

	document.addEventListener('vt:step', () => { sfx.whoosh(); restart(consoleEl, 'wiping'); });
	document.addEventListener('vt:tab', () => { sfx.tab(); restart(consoleEl, 'wiping'); });
	document.addEventListener('vt:error', () => { sfx.error(); restart(consoleEl, 'glitch'); });
	document.addEventListener('vt:transmit', () => { sfx.transmit(); consoleEl.classList.add('charging'); });

	const shockwave = (color: string) => {
		const wrap = pass.parentElement!;
		for (let i = 0; i < 3; i++) {
			const r = document.createElement('span');
			r.className = 'shock';
			r.style.setProperty('--c', color);
			r.style.animationDelay = `${i * 0.14}s`;
			wrap.appendChild(r);
			setTimeout(() => r.remove(), 1600);
		}
	};
	document.addEventListener('vt:success', () => {
		consoleEl.classList.remove('charging');
		sfx.success();
		restart(pass, 'flip');
		shockwave('#f5b84b');
		const [x, y] = centerOf(pass);
		setTimeout(() => burst(x, y, 90, ['#8ec5ff', '#3b82f6', '#f5b84b', '#ffffff'], 9), 350);
	});
	document.addEventListener('vt:status', (e) => {
		const st = (e as CustomEvent).detail;
		if (st === 'valide') {
			sfx.granted();
			restart(pass, 'flip');
			shockwave('#34c76f');
			const [x, y] = centerOf(pass);
			setTimeout(() => burst(x, y, 110, ['#34c76f', '#8ec5ff', '#ffffff'], 10), 300);
			setTimeout(() => confetti(['#34c76f', '#8ec5ff', '#3b82f6', '#ffffff', '#e98a6b']), 500);
		}
	});

	// « Entrer dans le Village » : flash de téléportation (le lien s'ouvre normalement)
	document.addEventListener('click', (e) => {
		const a = (e.target as HTMLElement).closest('.btn-enter');
		if (!a) return;
		sfx.warp();
		const [x, y] = centerOf(a);
		burst(x, y, 60, ['#34c76f', '#ffffff', '#8ec5ff'], 8);
		restart(byId('flash'), 'pulse');
	});
</script>

<style>
	/* ================= BASE ================= */
	:global(body) {
		background: #04070f;
	}
	.portal {
		--glass: #0b1530b3;
		--edge: #8ec5ff3d;
		--mono: 'JetBrains Mono', ui-monospace, monospace;
		position: relative;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		isolation: isolate;
	}
	.mono {
		font-family: var(--mono);
		letter-spacing: 0.08em;
	}
	.tiny {
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--ink-dim);
		margin: 0;
	}
	.label {
		font-size: 0.78rem;
		color: var(--sky);
		text-transform: uppercase;
		margin: 0 0 18px;
	}
	.portal [hidden] {
		display: none !important;
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	/* ================= DÉCOR ================= */
	.bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}
	.bg-city {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 25%;
		opacity: 0.38;
		filter: saturate(1.3) hue-rotate(-8deg);
		transform: scale(1.06);
		translate: calc(var(--px, 0) * -40px) calc(var(--py, 0) * -24px);
		animation: drift 40s ease-in-out infinite alternate;
	}
	@keyframes drift {
		to {
			transform: scale(1.14) translate(-1.5%, -1%);
		}
	}
	.bg-floor {
		position: absolute;
		translate: calc(var(--px, 0) * 30px) 0;
		left: -50%;
		right: -50%;
		bottom: -10%;
		height: 62%;
		perspective: 420px;
		mask-image: linear-gradient(180deg, transparent, #000 30%);
	}
	.bg-grid {
		position: absolute;
		inset: 0;
		transform: rotateX(68deg);
		transform-origin: 50% 0;
		background-image: linear-gradient(#3b82f655 1px, transparent 1px),
			linear-gradient(90deg, #3b82f655 1px, transparent 1px);
		background-size: 64px 64px;
		animation: grid 3.5s linear infinite;
	}
	@keyframes grid {
		to {
			background-position: 0 64px;
		}
	}
	.bg-particles {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.bg-beam {
		position: absolute;
		left: 50%;
		top: -20%;
		width: 60vw;
		height: 90%;
		transform: translateX(-50%);
		background: radial-gradient(ellipse at 50% 0%, #3b82f640, transparent 65%);
	}
	.bg-scan {
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(180deg, #ffffff06 0 1px, transparent 1px 3px);
		mix-blend-mode: overlay;
	}
	.bg-scan::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 140px;
		background: linear-gradient(180deg, transparent, #8ec5ff14, transparent);
		animation: sweep 7s linear infinite;
	}
	@keyframes sweep {
		from {
			top: -140px;
		}
		to {
			top: 100%;
		}
	}
	.bg-vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 85% 75% at 50% 45%, transparent 35%, #04070fee 100%);
	}

	/* ================= HUD ================= */
	.hud {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px clamp(16px, 4vw, 40px);
	}
	.hud-top {
		border-bottom: 1px solid #8ec5ff1a;
		background: linear-gradient(180deg, #04070fcc, transparent);
	}
	.hud-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.86rem;
		letter-spacing: 0.26em;
		text-transform: uppercase;
	}
	.hud-brand img {
		border-radius: 9px;
		box-shadow: 0 0 20px #3b82f666;
	}
	.hud-center {
		margin: 0;
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.3em;
		color: var(--sky);
	}
	.blink {
		animation: blink 1.4s steps(2) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0.2;
		}
	}
	.hud-right {
		display: flex;
		gap: 18px;
		font-size: 0.72rem;
		color: var(--ink-dim);
		text-transform: uppercase;
	}
	.sys {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--online);
		box-shadow: 0 0 10px var(--online);
		animation: blink 2s ease-in-out infinite;
	}
	#clock {
		color: var(--ink);
		min-width: 8ch;
		text-align: right;
	}
	.hud-bottom {
		font-size: 0.7rem;
		text-transform: uppercase;
		color: var(--ink-dim);
		border-top: 1px solid #8ec5ff14;
		flex-wrap: wrap;
	}
	.hud-bottom a {
		text-decoration: none;
	}
	.hud-bottom a:hover {
		color: var(--sky);
	}
	@media (max-width: 900px) {
		.hud-center,
		.sys {
			display: none;
		}
	}
	@media (max-width: 520px) {
		.hud-brand span {
			display: none;
		}
		.hud-bottom {
			justify-content: center;
		}
	}

	/* ================= SCÈNE ================= */
	.stage {
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(28px, 5vw, 80px);
		align-items: center;
		width: 100%;
		max-width: 1240px;
		margin: 0 auto;
		padding: clamp(24px, 5vh, 56px) clamp(16px, 4vw, 40px);
	}
	@media (max-width: 960px) {
		.stage {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* ================= PASS ================= */
	.pass-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.pass-wrap {
		position: relative;
		translate: calc(var(--px, 0) * -14px) calc(var(--py, 0) * -10px);
		width: 100%;
		display: grid;
		place-items: center;
		padding: 40px 0;
		perspective: 1100px;
	}
	.rings {
		position: absolute;
		width: min(560px, 120%);
		aspect-ratio: 1;
		left: 50%;
		top: 50%;
		translate: calc(-50% + var(--px, 0) * 50px) calc(-50% + var(--py, 0) * 40px);
		fill: none;
		pointer-events: none;
	}
	.rings circle {
		transform-origin: 300px 300px;
		stroke: #8ec5ff;
	}
	.r1 {
		stroke-opacity: 0.25;
		stroke-width: 1;
		stroke-dasharray: 2 10;
		animation: spin 60s linear infinite;
	}
	.r2 {
		stroke-opacity: 0.35;
		stroke-width: 1.5;
		stroke-dasharray: 120 30 8 30;
		animation: spin 28s linear infinite reverse;
	}
	.r3 {
		stroke: #3b82f6;
		stroke-opacity: 0.5;
		stroke-width: 2;
		stroke-dasharray: 60 260;
		animation: spin 9s linear infinite;
		filter: drop-shadow(0 0 6px #3b82f6);
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.pass {
		--rx: 0deg;
		--ry: 0deg;
		--mx: 50%;
		--my: 30%;
		--state: #8ec5ff;
		position: relative;
		width: min(400px, 100%);
		aspect-ratio: 1.55 / 2;
		max-height: 560px;
		padding: 26px;
		border-radius: 26px;
		text-align: left;
		display: flex;
		flex-direction: column;
		background: linear-gradient(155deg, #16285099 0%, #0a1430e6 55%, #060c1ef2 100%);
		border: 1px solid #8ec5ff55;
		box-shadow: 0 0 0 1px #ffffff0d inset, 0 30px 80px -20px #000, 0 0 60px -10px #3b82f688;
		backdrop-filter: blur(16px);
		transform: rotateX(var(--rx)) rotateY(var(--ry));
		transform-style: preserve-3d;
		transition: transform 0.2s ease-out, box-shadow 0.4s;
		animation: float 6s ease-in-out infinite;
		overflow: hidden;
	}
	@keyframes float {
		50% {
			translate: 0 -10px;
		}
	}
	.pass[data-state='pending'] {
		--state: #f5b84b;
	}
	.pass[data-state='valide'] {
		--state: #34c76f;
		box-shadow: 0 0 0 1px #ffffff0d inset, 0 30px 80px -20px #000, 0 0 80px -6px #34c76f88;
	}
	.pass[data-state='refuse'] {
		--state: #ff8a7a;
	}
	.pass-sheen {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at var(--mx) var(--my), #8ec5ff30, transparent 45%),
			linear-gradient(115deg, transparent 30%, #ffffff12 45%, #e98a6b14 50%, transparent 62%);
		background-size: 100% 100%, 250% 100%;
		animation: sheen 6s ease-in-out infinite;
		pointer-events: none;
	}
	@keyframes sheen {
		0%,
		100% {
			background-position: 0 0, 120% 0;
		}
		50% {
			background-position: 0 0, -20% 0;
		}
	}
	.pass > *:not(.pass-sheen) {
		position: relative;
		transform: translateZ(30px);
	}
	.pass-top {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.22em;
	}
	.pass-top img {
		border-radius: 7px;
	}
	.pass-tag {
		margin-left: auto;
		padding: 3px 9px;
		border: 1px solid var(--sky);
		border-radius: 999px;
		color: var(--sky);
		font-size: 0.62rem;
	}
	.pass-holo {
		flex: 1;
		position: relative;
		display: grid;
		place-items: center;
		min-height: 120px;
		margin: 10px 0;
	}
	.pass-holo img {
		width: 46%;
		max-width: 150px;
		border-radius: 22%;
		opacity: 0.85;
		mix-blend-mode: screen;
		filter: drop-shadow(0 0 24px #3b82f6) saturate(1.3);
		mask-image: repeating-linear-gradient(180deg, #000 0 2px, #0008 2px 4px);
		animation: holo 4s ease-in-out infinite;
	}
	@keyframes holo {
		0%, 100% { transform: translateY(0); opacity: 0.85; }
		47% { opacity: 0.85; }
		50% { opacity: 0.4; transform: translateY(-4px) skewX(-4deg); }
		53% { opacity: 0.85; }
		70% { transform: translateY(-8px); }
	}
	.holo-scan {
		position: absolute;
		left: 20%;
		right: 20%;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--sky), transparent);
		box-shadow: 0 0 12px var(--sky);
		animation: holoScan 3s ease-in-out infinite;
	}
	@keyframes holoScan {
		0%, 100% { top: 12%; opacity: 0; }
		15%, 85% { opacity: 1; }
		50% { top: 82%; }
	}
	.holo-base {
		position: absolute;
		bottom: 0;
		width: 60%;
		height: 18px;
		border-radius: 50%;
		border: 1px solid #8ec5ff66;
		background: radial-gradient(ellipse, #3b82f655, transparent 70%);
		box-shadow: 0 0 30px #3b82f655;
	}
	.pass-id {
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.avatar {
		flex: none;
		width: 78px;
		height: 78px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		padding: 3px;
		background: conic-gradient(from 0deg, var(--sky), var(--blue), var(--sunset), var(--sky));
		animation: spin 8s linear infinite;
	}
	.avatar span {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: #0a1430;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.6rem;
		animation: spin 8s linear infinite reverse;
	}
	.pass-who {
		min-width: 0;
	}
	.pass-who p {
		margin: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.pass-name {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.55rem;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	.pass-role {
		color: var(--ink-dim);
		font-size: 0.92rem;
	}
	.pass-handle {
		color: var(--sky);
		font-size: 0.8rem;
		margin-top: 4px !important;
	}
	.pass-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 22px 0;
	}
	.chip {
		padding: 5px 12px;
		border-radius: 999px;
		background: #ffffff0d;
		border: 1px solid #ffffff1f;
		font-size: 0.78rem;
		color: #d6deea;
	}
	.pass-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px;
		padding-top: 18px;
		border-top: 1px dashed #8ec5ff40;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 4px 0 8px;
		font-weight: 600;
		color: var(--state);
		transition: color 0.4s;
	}
	.status i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--state);
		box-shadow: 0 0 10px var(--state);
		animation: blink 1.6s ease-in-out infinite;
	}
	.code {
		color: #8ec5ffaa;
	}
	.qr {
		width: 66px;
		height: 66px;
		padding: 6px;
		border-radius: 10px;
		background: #e9f2ff;
		color: #0a1430;
		fill: #0a1430;
		flex: none;
	}
	.pass-hint {
		margin: 4px 0 0;
		color: var(--ink-dim);
		font-size: 0.88rem;
		max-width: 340px;
	}
	@media (max-width: 960px) {
		.pass-wrap {
			padding: 14px 0;
		}
		.pass {
			aspect-ratio: auto;
			min-height: 0;
		}
		.pass-holo {
			display: none;
		}
		.pass-id {
			margin-top: 24px;
		}
		.rings {
			width: 420px;
		}
	}

	/* ================= CONSOLE ================= */
	.console {
		position: relative;
		padding: clamp(22px, 3.5vw, 40px);
		background: linear-gradient(180deg, #0e1b3ccc, #070f24e6);
		border: 1px solid var(--edge);
		border-radius: 8px;
		backdrop-filter: blur(20px) saturate(1.2);
		box-shadow: 0 0 0 1px #ffffff08 inset, 0 40px 120px -40px #000, 0 0 80px -30px #3b82f6aa;
		clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 26px, 100% 100%, 26px 100%, 0 calc(100% - 26px));
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(24px) scale(0.98);
		}
	}
	.corner {
		position: absolute;
		width: 22px;
		height: 22px;
		border: 2px solid var(--sky);
		filter: drop-shadow(0 0 6px #3b82f6);
	}
	.corner.tl {
		top: 10px;
		left: 10px;
		border-right: 0;
		border-bottom: 0;
	}
	.corner.tr {
		top: 10px;
		right: 36px;
		border-left: 0;
		border-bottom: 0;
		width: 12px;
	}
	.corner.bl {
		bottom: 10px;
		left: 36px;
		border-right: 0;
		border-top: 0;
		width: 12px;
	}
	.corner.br {
		bottom: 10px;
		right: 10px;
		border-left: 0;
		border-top: 0;
	}

	.boot {
		min-height: 3.6em;
		font-size: 0.72rem;
		color: #8ec5ffb3;
		margin-bottom: 18px;
	}
	.boot :global(p) {
		margin: 0;
		line-height: 1.2em;
	}
	.boot :global(b) {
		color: var(--online);
		font-weight: 500;
	}

	/* onglets */
	.tabs {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 4px;
		border-radius: 12px;
		background: #04070f99;
		border: 1px solid #8ec5ff26;
		margin-bottom: 28px;
	}
	.tabs button {
		position: relative;
		z-index: 1;
		border: 0;
		background: none;
		color: var(--ink-dim);
		font: 600 0.95rem var(--font-body);
		padding: 12px 10px;
		cursor: pointer;
		transition: color 0.25s;
	}
	.tabs button[aria-selected='true'] {
		color: #fff;
	}
	.tabs button:focus-visible {
		outline: 2px solid var(--sky);
		outline-offset: -2px;
		border-radius: 9px;
	}
	.tab-ink {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 4px;
		width: calc(50% - 4px);
		border-radius: 9px;
		background: linear-gradient(180deg, #3b82f6, #2563eb);
		box-shadow: 0 0 24px #3b82f6aa;
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.tabs[data-active='log'] .tab-ink {
		transform: translateX(100%);
	}

	/* étapes */
	.steps {
		display: flex;
		gap: 6px;
		list-style: none;
		padding: 0;
		margin: 0 0 12px;
		align-items: center;
		font-size: 0.7rem;
		text-transform: uppercase;
	}
	.steps li {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: #a6b1c488;
		transition: color 0.3s;
	}
	.steps li b {
		font-weight: 700;
		margin-right: 6px;
		color: inherit;
	}
	.steps li.on {
		color: var(--sky);
	}
	.steps li.done,
	.steps.complete li {
		color: var(--online);
	}
	.progress {
		height: 3px;
		border-radius: 3px;
		background: #ffffff12;
		overflow: hidden;
		margin-bottom: 28px;
	}
	.progress span {
		display: block;
		height: 100%;
		width: 0;
		background: linear-gradient(90deg, var(--sky), var(--blue), var(--sunset));
		box-shadow: 0 0 12px var(--blue);
		transition: width 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	/* champs */
	fieldset {
		border: 0;
		padding: 0;
		margin: 0;
		min-width: 0;
		display: none;
		flex-direction: column;
		gap: 20px;
	}
	fieldset.on {
		display: flex;
		animation: stepIn 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	@keyframes stepIn {
		from {
			opacity: 0;
			transform: translateX(18px);
		}
	}
	fieldset.shake {
		animation: shake 0.4s;
	}
	@keyframes shake {
		25% {
			transform: translateX(-6px);
		}
		75% {
			transform: translateX(6px);
		}
	}
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	@media (max-width: 520px) {
		.steps {
			font-size: 0.62rem;
		}
		.boot {
			display: none;
		}
		.row {
			grid-template-columns: 1fr;
			gap: 20px;
		}
	}
	.field {
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.field input,
	.field textarea {
		width: 100%;
		font: 400 1.02rem var(--font-body);
		color: var(--ink);
		background: #04070f8c;
		border: 1px solid #8ec5ff2e;
		border-radius: 10px;
		padding: 24px 16px 10px;
		transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
	}
	.field textarea {
		resize: vertical;
		min-height: 120px;
	}
	.field label {
		position: absolute;
		left: 17px;
		top: 17px;
		font-size: 1rem;
		color: var(--ink-dim);
		pointer-events: none;
		transform-origin: 0 0;
		transition: transform 0.2s, color 0.2s, top 0.2s;
	}
	.field label em {
		font-style: normal;
		opacity: 0.6;
	}
	.field input:focus + label,
	.field input:not(:placeholder-shown) + label,
	.field textarea:focus + label,
	.field textarea:not(:placeholder-shown) + label {
		top: 8px;
		transform: scale(0.74);
		color: var(--sky);
		font-family: var(--mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--sky);
		background: #0a1430cc;
		box-shadow: 0 0 0 4px #3b82f626, 0 0 30px -6px #3b82f6aa;
	}
	.field input:not(:placeholder-shown):valid,
	.field textarea:not(:placeholder-shown):valid {
		border-color: #34c76f55;
	}
	.field small {
		margin-top: 8px;
		color: var(--ink-dim);
		font-size: 0.82rem;
	}
	.field small a {
		color: var(--sky);
	}
	.count {
		align-self: flex-end;
		font-size: 0.7rem !important;
	}
	.q {
		margin: 0 0 -8px;
		font-size: 0.72rem;
		text-transform: uppercase;
		color: var(--sky);
	}

	/* stades */
	.stages {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
		gap: 10px;
	}
	.stage-opt {
		position: relative;
		cursor: pointer;
	}
	.stage-opt input {
		position: absolute;
		opacity: 0;
		inset: 0;
		cursor: pointer;
	}
	.stage-opt span {
		display: flex;
		flex-direction: column;
		gap: 2px;
		height: 100%;
		padding: 14px;
		border-radius: 10px;
		border: 1px solid #8ec5ff2e;
		background: #04070f8c;
		font-size: 0.78rem;
		color: var(--ink-dim);
		transition: all 0.2s;
	}
	.stage-opt b {
		font-family: var(--font-display);
		font-size: 1rem;
		color: var(--ink);
	}
	.stage-opt:hover span {
		border-color: #8ec5ff77;
	}
	.stage-opt input:checked + span {
		border-color: var(--sky);
		background: linear-gradient(180deg, #3b82f633, #3b82f611);
		box-shadow: 0 0 0 1px var(--sky) inset, 0 0 24px -4px #3b82f6aa;
		color: #d6deea;
	}
	.stage-opt input:focus-visible + span {
		outline: 2px solid var(--sky);
		outline-offset: 2px;
	}

	/* consentement */
	.consent {
		position: relative;
		display: flex;
		gap: 14px;
		align-items: flex-start;
		font-size: 0.86rem;
		color: var(--ink-dim);
		cursor: pointer;
	}
	.consent input {
		position: absolute;
		opacity: 0;
		width: 20px;
		height: 20px;
	}
	.consent .box {
		flex: none;
		width: 20px;
		height: 20px;
		margin-top: 1px;
		border-radius: 5px;
		border: 1px solid #8ec5ff66;
		background: #04070f8c;
		display: grid;
		place-items: center;
		transition: all 0.2s;
	}
	.consent input:checked + .box {
		background: var(--blue);
		border-color: var(--sky);
		box-shadow: 0 0 14px #3b82f6aa;
	}
	.consent input:checked + .box::after {
		content: '✓';
		color: #fff;
		font-size: 0.8rem;
		font-weight: 700;
	}
	.consent input:focus-visible + .box {
		outline: 2px solid var(--sky);
		outline-offset: 2px;
	}
	.consent a {
		color: var(--sky);
	}
	.hp {
		position: absolute;
		left: -9999px;
	}

	.error {
		margin: 18px 0 0;
		padding: 10px 14px;
		border-left: 2px solid var(--danger);
		background: #ff8a7a14;
		color: var(--danger);
		font-size: 0.8rem;
	}

	/* boutons */
	.actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 28px;
	}
	.btn-go {
		margin-left: auto;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 16px 28px;
		border: 0;
		border-radius: 10px;
		cursor: pointer;
		color: #fff;
		font: 700 1rem var(--font-display);
		background: linear-gradient(180deg, #4b8ff8, #2563eb);
		box-shadow: 0 0 0 1px #8ec5ff66 inset, 0 10px 40px -8px #3b82f6;
		overflow: hidden;
		transition: transform 0.15s, box-shadow 0.25s;
	}
	.btn-go::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(110deg, transparent 30%, #ffffff40 50%, transparent 70%);
		transform: translateX(-100%);
		transition: transform 0.6s;
	}
	.btn-go:hover::before {
		transform: translateX(100%);
	}
	.btn-go:hover {
		transform: translateY(-1px);
		box-shadow: 0 0 0 1px #8ec5ff inset, 0 14px 50px -6px #3b82f6;
	}
	.btn-go span {
		transition: transform 0.2s;
	}
	.btn-go:hover span {
		transform: translateX(4px);
	}
	.btn-go:disabled {
		opacity: 0.7;
		cursor: wait;
	}
	.btn-go:focus-visible,
	.btn-back:focus-visible,
	.btn-enter:focus-visible,
	.btn-ghost-hud:focus-visible {
		outline: 2px solid var(--sky);
		outline-offset: 3px;
	}
	.btn-back,
	.btn-ghost-hud {
		border: 1px solid #8ec5ff33;
		background: transparent;
		color: var(--ink-dim);
		padding: 14px 20px;
		border-radius: 10px;
		font: 500 0.95rem var(--font-body);
		cursor: pointer;
	}
	.btn-back:hover,
	.btn-ghost-hud:hover {
		color: var(--ink);
		border-color: var(--sky);
	}

	/* transmission */
	.transmit {
		text-align: center;
		padding: 40px 0 20px;
	}
	.transmit .progress {
		max-width: 320px;
		margin: 18px auto 0;
	}
	.transmit p {
		margin: 0;
		color: var(--sky);
		font-size: 0.82rem;
		text-transform: uppercase;
	}
	.orb {
		width: 90px;
		height: 90px;
		margin: 0 auto 26px;
		border-radius: 50%;
		border: 2px solid transparent;
		border-top-color: var(--sky);
		border-right-color: var(--blue);
		box-shadow: 0 0 40px #3b82f688, inset 0 0 30px #3b82f644;
		animation: spin 0.9s linear infinite;
	}

	/* succès */
	.done {
		padding: 10px 0;
		outline: none;
		animation: stepIn 0.5s;
	}
	.done .ok {
		color: var(--online);
	}
	.done h2 {
		font-size: clamp(1.8rem, 3.6vw, 2.4rem);
	}
	.done p {
		color: var(--ink-dim);
		margin: 0 0 26px;
	}

	/* connexion */
	.log-intro {
		color: var(--ink-dim);
		margin: 0 0 24px;
	}
	#check-form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	#check-form .actions {
		margin-top: 8px;
	}
	.result {
		--c: var(--sky);
		margin-top: 26px;
		padding: 20px 22px;
		border-radius: 12px;
		border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
		background: color-mix(in srgb, var(--c) 9%, transparent);
		animation: stepIn 0.4s;
	}
	.result.ok {
		--c: #34c76f;
	}
	.result.wait {
		--c: #f5b84b;
	}
	.result.no {
		--c: #ff8a7a;
	}
	.result.none {
		--c: #a6b1c4;
	}
	.result :global(.tiny) {
		font-family: var(--mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--ink-dim);
		margin: 0;
	}
	.result :global(.r-title) {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 6px 0 6px;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.35rem;
		color: var(--c);
	}
	.result :global(.r-title i) {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--c);
		box-shadow: 0 0 12px var(--c);
	}
	.result :global(.r-text) {
		margin: 0;
		color: #d6deea;
	}
	.result :global(.btn-enter) {
		margin-top: 18px;
	}
	.enter {
		margin-top: 34px;
		padding-top: 24px;
		border-top: 1px dashed #8ec5ff33;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}
	.btn-enter,
	:global(.btn-enter) {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		padding: 14px 22px;
		border-radius: 10px;
		text-decoration: none;
		font: 700 1rem var(--font-display);
		color: #04170c;
		background: linear-gradient(180deg, #5ee08f, #2fb864);
		box-shadow: 0 0 30px -4px #34c76faa;
		transition: transform 0.15s, box-shadow 0.25s;
	}
	.btn-enter:hover,
	:global(.btn-enter:hover) {
		transform: translateY(-1px);
		box-shadow: 0 0 44px -2px #34c76fcc;
	}


	/* ================= IMMERSION ================= */
	.portal {
		--px: 0;
		--py: 0;
	}
	/* --- entrée en scène --- */
	.hud-top,
	.hud-bottom,
	.pass-col,
	.console {
		transition: opacity 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
			filter 0.9s;
	}
	.portal.pre .hud-top {
		opacity: 0;
		transform: translateY(-30px);
	}
	.portal.pre .hud-bottom {
		opacity: 0;
		transform: translateY(30px);
	}
	.portal.pre .pass-col {
		opacity: 0;
		transform: perspective(900px) translateX(-80px) rotateY(35deg) scale(0.9);
		filter: blur(8px);
	}
	.portal.pre .console {
		opacity: 0;
		transform: perspective(900px) translateX(80px) rotateY(-25deg) scale(0.92);
		filter: blur(8px);
	}
	.portal.ready .pass-col {
		transition-delay: 0.15s;
	}
	.portal.ready .console {
		transition-delay: 0.3s;
	}
	.portal.ready .hud-bottom {
		transition-delay: 0.5s;
	}
	.portal.ready .boot {
		animation: fadeIn 0.4s 0.8s both;
	}
	@keyframes fadeIn {
		from {
			opacity: 0;
		}
	}

	/* --- intro --- */
	.intro {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-items: center;
		background: radial-gradient(ellipse at center, #0b1a3d 0%, #02050c 70%);
		cursor: pointer;
		transition: opacity 0.7s, transform 0.9s cubic-bezier(0.7, 0, 0.3, 1);
	}
	.intro canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.intro-core {
		position: relative;
		text-align: center;
		transition: transform 0.6s cubic-bezier(0.7, 0, 0.84, 0), opacity 0.5s;
	}
	.intro-logo {
		width: 120px;
		height: 120px;
		overflow: visible;
		filter: drop-shadow(0 0 18px #3b82f6) drop-shadow(0 0 40px #3b82f688);
	}
	.intro-logo path {
		stroke-width: 1.4;
		stroke-linejoin: round;
		stroke-dasharray: 260;
		stroke-dashoffset: 260;
		fill-opacity: 0;
		animation: draw 1.3s cubic-bezier(0.6, 0, 0.2, 1) forwards, fillIn 0.6s 1.1s forwards;
	}
	.v-l {
		stroke: #8ec5ff;
		fill: #8ec5ff;
	}
	.v-r {
		stroke: #3b82f6;
		fill: #3b82f6;
		animation-delay: 0.15s, 1.2s !important;
	}
	.v-s {
		stroke: #3b82f6;
		fill: #3b82f6;
		animation-delay: 0.45s, 1.3s !important;
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes fillIn {
		to {
			fill-opacity: 1;
		}
	}
	.intro-title {
		margin: 22px 0 6px;
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.5em;
		text-transform: uppercase;
		padding-left: 0.5em;
		animation: track 1.6s 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}
	@keyframes track {
		from {
			letter-spacing: 1.4em;
			opacity: 0;
			filter: blur(6px);
		}
	}
	.intro-sub {
		margin: 0;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.24em;
		color: var(--sky);
		min-height: 1.2em;
	}
	.intro-bar {
		width: 220px;
		height: 2px;
		margin: 18px auto 0;
		background: #ffffff14;
		overflow: hidden;
		border-radius: 2px;
	}
	.intro-bar span {
		display: block;
		height: 100%;
		width: 100%;
		transform-origin: 0 50%;
		background: linear-gradient(90deg, var(--sky), var(--blue), var(--sunset));
		box-shadow: 0 0 10px var(--blue);
		animation: load 2.3s cubic-bezier(0.4, 0, 0.2, 1) both;
	}
	@keyframes load {
		from {
			transform: scaleX(0);
		}
	}
	.intro-skip {
		position: absolute;
		bottom: 28px;
		margin: 0;
		font-size: 0.66rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: #a6b1c477;
		animation: blink 2s ease-in-out infinite;
	}
	.intro.warp .intro-core {
		transform: scale(3.2);
		opacity: 0;
	}
	.intro.out {
		opacity: 0;
		transform: scale(1.25);
		pointer-events: none;
	}
	.flash {
		position: fixed;
		inset: 0;
		z-index: 101;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(circle at center, #ffffff, #8ec5ff 30%, transparent 70%);
	}
	.flash.on {
		animation: flash 0.8s ease-out;
	}
	.flash.pulse {
		animation: flash 0.6s ease-out;
	}
	@keyframes flash {
		0% {
			opacity: 0;
		}
		15% {
			opacity: 0.85;
		}
		100% {
			opacity: 0;
		}
	}

	/* --- curseur + canvas fx --- */
	.cursor-glow {
		position: fixed;
		left: -300px;
		top: -300px;
		width: 600px;
		height: 600px;
		border-radius: 50%;
		pointer-events: none;
		z-index: 0;
		background: radial-gradient(circle, #3b82f626 0%, #8ec5ff0d 35%, transparent 65%);
		mix-blend-mode: screen;
		opacity: 0;
		transition: opacity 0.6s;
	}
	.cursor-glow.on {
		opacity: 1;
	}
	.fx {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 60;
	}

	/* --- décor vivant --- */
	.searchlight {
		position: absolute;
		bottom: -5%;
		width: 140px;
		height: 120vh;
		transform-origin: 50% 100%;
		background: linear-gradient(0deg, #8ec5ff40, #8ec5ff10 50%, transparent 85%);
		clip-path: polygon(46% 100%, 54% 100%, 100% 0, 0 0);
		filter: blur(6px);
		mix-blend-mode: screen;
	}
	.s1 {
		left: 38%;
		animation: sweepL 14s ease-in-out infinite alternate;
	}
	.s2 {
		left: 58%;
		animation: sweepR 17s ease-in-out infinite alternate;
	}
	@keyframes sweepL {
		from {
			transform: rotate(-38deg);
		}
		to {
			transform: rotate(12deg);
		}
	}
	@keyframes sweepR {
		from {
			transform: rotate(32deg);
		}
		to {
			transform: rotate(-14deg);
		}
	}
	.airship {
		position: absolute;
		top: 14%;
		left: -140px;
		width: 120px;
		fill: #0d1a33;
		stroke: #8ec5ff55;
		stroke-width: 1;
		filter: drop-shadow(0 0 8px #3b82f644);
		translate: calc(var(--px, 0) * -60px) calc(var(--py, 0) * -30px);
		animation: fly 95s linear infinite;
	}
	.air-light {
		fill: #ff5a5a;
		stroke: none;
		animation: blink 1.2s steps(2) infinite;
	}
	@keyframes fly {
		from {
			transform: translateX(0) translateY(0);
		}
		50% {
			transform: translateX(60vw) translateY(14px);
		}
		to {
			transform: translateX(calc(100vw + 280px)) translateY(0);
		}
	}
	.star-shoot {
		position: absolute;
		width: 160px;
		height: 1px;
		background: linear-gradient(90deg, #ffffff, transparent);
		opacity: 0;
		transform: rotate(-24deg);
	}
	.star-shoot.a {
		top: 12%;
		left: 70%;
		animation: shoot 9s 2s ease-in infinite;
	}
	.star-shoot.b {
		top: 6%;
		left: 35%;
		animation: shoot 13s 6s ease-in infinite;
	}
	.star-shoot.c {
		top: 22%;
		left: 90%;
		animation: shoot 11s 9s ease-in infinite;
	}
	@keyframes shoot {
		0% {
			opacity: 0;
			translate: 0 0;
		}
		2% {
			opacity: 1;
		}
		8% {
			opacity: 0;
			translate: -340px 150px;
		}
		100% {
			opacity: 0;
			translate: -340px 150px;
		}
	}

	/* --- bouton son --- */
	.sound {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		border-radius: 999px;
		border: 1px solid #8ec5ff33;
		background: #04070f88;
		color: var(--ink-dim);
		font: 500 0.68rem var(--mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		cursor: pointer;
		transition: border-color 0.2s, color 0.2s;
	}
	.sound:hover,
	.sound.on {
		color: var(--ink);
		border-color: var(--sky);
	}
	.sound:focus-visible {
		outline: 2px solid var(--sky);
		outline-offset: 2px;
	}
	.eq {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		height: 10px;
	}
	.eq i {
		width: 2px;
		height: 3px;
		background: currentColor;
		border-radius: 1px;
	}
	.sound.on .eq i {
		background: var(--sky);
		animation: eq 0.9s ease-in-out infinite;
	}
	.sound.on .eq i:nth-child(2) {
		animation-delay: 0.2s;
	}
	.sound.on .eq i:nth-child(3) {
		animation-delay: 0.4s;
	}
	.sound.on .eq i:nth-child(4) {
		animation-delay: 0.1s;
	}
	@keyframes eq {
		50% {
			height: 10px;
		}
	}

	/* --- console vivante --- */
	.run {
		position: absolute;
		height: 1px;
		width: 160px;
		pointer-events: none;
		background: linear-gradient(90deg, transparent, var(--sky), #fff, var(--sky), transparent);
		box-shadow: 0 0 10px var(--sky);
	}
	.run-t {
		top: 0;
		animation: runT 5s linear infinite;
	}
	.run-b {
		bottom: 0;
		animation: runB 6.5s linear infinite;
	}
	@keyframes runT {
		from {
			left: -160px;
		}
		to {
			left: 100%;
		}
	}
	@keyframes runB {
		from {
			left: 100%;
		}
		to {
			left: -160px;
		}
	}
	.wipe {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		background: linear-gradient(90deg, transparent 0%, #8ec5ff22 40%, #8ec5ff66 50%, #8ec5ff22 60%, transparent 100%),
			repeating-linear-gradient(180deg, #8ec5ff14 0 1px, transparent 1px 4px);
		background-size: 300% 100%, 100% 100%;
		z-index: 2;
	}
	.console.wiping .wipe {
		animation: wipe 0.7s ease-out;
	}
	@keyframes wipe {
		0% {
			opacity: 1;
			background-position: 100% 0, 0 0;
		}
		100% {
			opacity: 0;
			background-position: 0% 0, 0 0;
		}
	}
	.console.glitch {
		animation: glitch 0.45s steps(2);
	}
	@keyframes glitch {
		0% {
			transform: translate(0);
			border-color: var(--danger);
		}
		20% {
			transform: translate(-4px, 1px) skewX(-1deg);
			filter: hue-rotate(140deg) saturate(2);
		}
		40% {
			transform: translate(4px, -1px);
			filter: none;
		}
		60% {
			transform: translate(-2px, 0) skewX(1deg);
			filter: hue-rotate(-60deg);
		}
		100% {
			transform: translate(0);
		}
	}
	.console.charging {
		box-shadow: 0 0 0 1px #8ec5ff33 inset, 0 0 120px -10px #3b82f6;
		animation: charge 0.6s ease-in-out infinite alternate;
	}
	@keyframes charge {
		to {
