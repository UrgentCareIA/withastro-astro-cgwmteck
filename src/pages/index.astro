---
import Layout from '../layouts/Layout.astro';

// Les 7 lieux (mêmes textes que la visite guidée Instagram)
const lieux = [
	{ img: 'accueil', title: "L'accueil", text: 'Une hôtesse reçoit chaque visiteur et l’oriente.' },
	{ img: 'poste', title: 'Ton poste', text: 'Tout ton travail, au même endroit : tâches, documents, agenda, messages.' },
	{ img: 'reunion', title: 'La salle de réunion', text: 'Une vraie salle, un grand écran où l’on présente et dessine.' },
	{ img: 'academie', title: "L'Académie", text: 'Le bâtiment de formation du Campus. Des cours, des ateliers, une bibliothèque.' },
	{ img: 'amphi', title: "L'Amphithéâtre", text: 'Présente ton projet devant le Village.' },
	{ img: 'marche', title: 'Le Marché', text: 'Les articles digitaux du Village.' },
	{ img: 'collegues', title: 'Tes collègues', text: 'À portée de voix, comme au bureau.' },
];

const steps = [
	{ n: '01', title: 'Tu demandes ton accès', text: 'Un formulaire court : qui tu es, ton projet, ton pseudo Higgsfield. Deux minutes.' },
	{ n: '02', title: 'On valide ton compte', text: 'On lit chaque demande et on active ton compte nous-mêmes, directement sur Higgsfield.' },
	{ n: '03', title: 'Tu entres dans le Village', text: 'Tu reçois un mail, tu te connectes, tu visites. Tes retours façonnent la suite.' },
];

const faq = [
	{ q: "C'est vraiment gratuit ?", a: "Oui. Pendant la bêta, pas d'abonnement, pas de carte bancaire. On te demande juste tes retours." },
	{ q: 'Pourquoi une validation si c’est gratuit ?', a: "Le Village marche s'il est habité par de vrais entrepreneurs. On veut savoir qui entre, garder une communauté saine et pouvoir te contacter pour tes retours." },
	{ q: 'Il faut un compte Higgsfield ?', a: "Oui, le Village tourne sur Higgsfield. Crée un compte gratuit si tu n'en as pas, puis indique ton pseudo dans le formulaire : c'est lui qu'on active." },
	{ q: 'Combien de temps pour être validé ?', a: 'On traite les demandes à la main, en général sous quelques jours. Tu reçois un mail dès que ton accès est ouvert.' },
	{ q: 'Je peux venir avec mon équipe ?', a: "Oui : c'est fait pour ça. Chaque membre fait sa demande et précise le nom de l'entreprise, on vous installe ensemble." },
	{ q: 'Je ne suis pas encore lancé, je peux venir ?', a: "Oui. Idée, projet en cours ou boîte qui tourne : l'Académie et le mur V Pro sont justement là pour t'aider à avancer." },
];
---

<Layout>
	<!-- HERO -->
	<section class="hero">
		<video class="hero-bg" id="hero-video" src="/video/hydravion.mp4" poster="/video/hydravion.jpg" autoplay muted loop playsinline aria-hidden="true"></video>
		<div class="hero-fade" aria-hidden="true"></div>
		<div class="wrap hero-inner">
			<p class="eyebrow">Play · Build · Collaborate</p>
			<h1>La bêta est <span class="script">lancée !</span></h1>
			<p class="lede">
				Le Village Tech, c’est un monde en 3D pour les entrepreneurs : tu gères ton entreprise,
				tu collabores avec d’autres joueurs et tu développes ton empire. Gratuit pendant toute la bêta.
			</p>
			<div class="cta-row">
				<a href="/acces" class="btn">Demander mon accès bêta →</a>
				<a href="#film" class="btn-ghost">▶ Voir le film · 1:42</a>
			</div>
		</div>
	</section>

	<!-- FILM -->
	<section id="film" class="section wrap">
		<p class="eyebrow">Le film</p>
		<h2>Un vrai Campus, en ligne.</h2>
		<p class="dim section-lede">Des bâtiments, des salles, des gens. Tout est en 3D. Le tour complet en moins de 2 minutes.</p>
		<div class="film">
			<video
				id="film-video"
				src="/video/village-tech.mp4"
				poster="/video/poster.jpg"
				controls
				playsinline
				preload="none"
				width="848"
				height="480"
			>
				Ton navigateur ne lit pas la vidéo. <a href="/video/village-tech.mp4">Télécharge-la ici</a>.
			</video>
			<button class="film-play" id="film-play" aria-label="Lire le film de présentation">
				<span>▶</span>
			</button>
		</div>
	</section>

	<!-- VISITE GUIDÉE -->
	<section id="visite" class="section">
		<div class="wrap visite-head">
			<div>
				<p class="eyebrow">Visite guidée</p>
				<h2>Le Village Tech en 7 lieux.</h2>
			</div>
			<div class="carousel-ctrl">
				<span class="counter" aria-live="polite"><b id="cur">01</b> / 07</span>
				<button class="arrow" data-dir="-1" aria-label="Lieu précédent">←</button>
				<button class="arrow" data-dir="1" aria-label="Lieu suivant">→</button>
			</div>
		</div>
		<div class="carousel" id="carousel" tabindex="0" aria-label="Les 7 lieux du Village">
			{lieux.map((l, i) => (
				<article class="lieu">
					<div class="lieu-img">
						<img src={`/images/${l.img}.webp`} alt={l.title} loading={i < 2 ? 'eager' : 'lazy'} width="948" height="736" />
					</div>
					<span class="accent-line" />
					<h3>{l.title}</h3>
					<p>{l.text}</p>
				</article>
			))}
		</div>
		<div class="dots" aria-hidden="true">
			{lieux.map((_, i) => <span class={i === 0 ? 'on' : ''} />)}
		</div>
	</section>

	<!-- FEATURE : collègues -->
	<section class="section wrap split">
		<div class="split-img">
			<img src="/images/rencontre.webp" alt="Un entrepreneur croisé dans le hall, avec sa carte de profil : message, appel, rendez-vous" loading="lazy" width="650" height="880" />
		</div>
		<div>
			<span class="accent-line"></span>
			<h2>Tu croises un collègue. Tu lui parles.</h2>
			<p class="dim">
				Chaque habitant a sa carte : ce qu'il fait, s'il est disponible. Un clic pour lui écrire,
				l'appeler, caler un rendez-vous ou l'ajouter à tes contacts.
			</p>
			<ul class="ticks">
				<li><span class="dot-online"></span> Statut en direct : disponible, occupé</li>
				<li><span class="dot-online"></span> Message, appel, rendez-vous</li>
				<li><span class="dot-online"></span> Village Points pour ceux qui aident</li>
			</ul>
		</div>
	</section>

	<!-- FEATURE : V Pro -->
	<section class="section wrap">
		<div class="wide">
			<img src="/images/vpro.webp" alt="L'application V Pro : le mur des projets du Village" loading="lazy" width="1080" height="770" />
			<div class="wide-text">
				<span class="accent-line"></span>
				<h2>Trouve un associé, des clients, un financement.</h2>
				<p>V Pro, le mur des projets du Village : publie le tien, réponds aux demandes des autres.</p>
			</div>
		</div>
	</section>

	<!-- BÊTA -->
	<section id="beta" class="section wrap">
		<p class="eyebrow">Comment entrer</p>
		<h2>Gratuit, mais sur invitation.</h2>
		<p class="dim section-lede">
			On veut connaître chaque personne qui entre pendant la bêta. Tu fais ta demande, on active
			ton compte à la main sur Higgsfield.
		</p>
		<ol class="steps">
			{steps.map((s) => (
				<li class="step">
					<span class="step-n">{s.n}</span>
					<h3>{s.title}</h3>
					<p>{s.text}</p>
				</li>
			))}
		</ol>
	</section>

	<!-- FAQ -->
	<section id="faq" class="section wrap faq-wrap">
		<div>
			<p class="eyebrow">Questions</p>
			<h2>Avant de passer la porte.</h2>
		</div>
		<div class="faq">
			{faq.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p>{f.a}</p>
				</details>
			))}
		</div>
	</section>

	<!-- CTA FINAL -->
	<section class="section wrap">
		<div class="final">
			<svg class="rings" viewBox="0 0 1000 1000" aria-hidden="true">
				<circle cx="500" cy="500" r="480" class="r1" />
				<circle cx="500" cy="500" r="420" class="r2" />
				<circle cx="500" cy="500" r="355" class="r3" />
			</svg>
			<div class="final-text">
				<img class="final-logo" src="/images/logo.png" alt="" width="84" height="84" />
				<h2>Les portes sont <span class="script">ouvertes !</span></h2>
				<p>Le Village est ouvert à toute heure. Les places de la bêta sont limitées.</p>
				<a href="/acces" class="btn">Ouvrir le portail d'accès →</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;
	if (heroVideo && matchMedia('(prefers-reduced-motion: reduce)').matches) {
		heroVideo.removeAttribute('autoplay');
		heroVideo.pause();
	}
	const video = document.getElementById('film-video') as HTMLVideoElement;
	const playBtn = document.getElementById('film-play') as HTMLButtonElement;
	playBtn.addEventListener('click', () => {
		playBtn.hidden = true;
		video.play().catch(() => {});
	});
	video.addEventListener('play', () => (playBtn.hidden = true));

	const track = document.getElementById('carousel') as HTMLElement;
	const cur = document.getElementById('cur') as HTMLElement;
	const dots = document.querySelectorAll('.dots span');
	const cards = Array.from(track.querySelectorAll('.lieu')) as HTMLElement[];

	const step = () => (cards[1]?.offsetLeft ?? 0) - (cards[0]?.offsetLeft ?? 0);

	document.querySelectorAll<HTMLButtonElement>('.arrow').forEach((b) =>
		b.addEventListener('click', () => {
			track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' });
		}),
	);

	track.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') track.scrollBy({ left: step(), behavior: 'smooth' });
		if (e.key === 'ArrowLeft') track.scrollBy({ left: -step(), behavior: 'smooth' });
	});

	let ticking = false;
	track.addEventListener('scroll', () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
			const i = atEnd ? cards.length - 1 : Math.round(track.scrollLeft / (step() || 1));
			cur.textContent = String(i + 1).padStart(2, '0');
			dots.forEach((d, j) => d.classList.toggle('on', j === i));
			ticking = false;
		});
	});
</script>

<style>
	/* hero */
	.hero {
		position: relative;
		min-height: calc(100svh - 65px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 55% 50%;
	}
	.hero-fade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, #3346e055 0%, #3346e000 25%, #4a3fd422 45%, #3d33b8bb 75%, #3d36c0 100%),
			linear-gradient(90deg, #2b2fa877 0%, transparent 60%);
	}
	.hero-inner {
		position: relative;
		width: 100%;
		padding-bottom: 72px;
	}
	.hero h1 {
		font-size: clamp(2.8rem, 8vw, 6.4rem);
		max-width: 900px;
		text-shadow: 0 4px 40px #3346e099, 0 0 2px #ffffff55;
	}
	.hero .eyebrow {
		color: #fff;
		letter-spacing: 0.42em;
		text-shadow: 0 2px 14px #2b2fa8cc;
	}
	.hero h1 .script {
		font-size: 1.12em;
		margin-left: 0.1em;
		color: #fff;
		text-shadow: 0 0 30px #ff5fa288;
	}
	.lede {
		max-width: 560px;
		font-size: 1.18rem;
		color: #f1f3ff;
		margin: 0;
		text-shadow: 0 2px 20px #2b2fa8aa;
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 30px;
	}

	.section {
		padding-top: 120px;
	}
	.section h2 {
		font-size: clamp(2.1rem, 4.6vw, 3.6rem);
		max-width: 760px;
	}
	.dim {
		color: var(--ink-dim);
		font-size: 1.08rem;
	}
	.section-lede {
		max-width: 620px;
	}

	/* film */
	.film {
		position: relative;
		margin-top: 36px;
		border-radius: 28px;
		overflow: hidden;
		border: 1px solid #8ec5ff40;
		box-shadow: 0 40px 100px -40px #3b82f677;
		background: #000;
		aspect-ratio: 848 / 480;
	}
	.film video {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}
	.film-play {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 0;
		background: radial-gradient(circle at 50% 50%, #3346e022, #2b2a9a77);
		cursor: pointer;
	}
	.film-play span {
		width: 88px;
		height: 88px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-left: 6px;
		font-size: 1.8rem;
		color: #fff;
		background: linear-gradient(180deg, #4b8ff8, var(--blue-2));
		box-shadow: 0 0 0 10px #3b82f633, 0 10px 40px #3b82f6aa;
		transition: transform 0.2s;
	}
	.film-play:hover span {
		transform: scale(1.06);
	}
	.film-play:focus-visible span {
		outline: 2px solid var(--sky);
		outline-offset: 6px;
	}
	.film-play[hidden] {
		display: none;
	}

	/* carrousel */
	.visite-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 20px;
		flex-wrap: wrap;
	}
	.carousel-ctrl {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 24px;
	}
	.counter {
		font-size: 1.3rem;
		letter-spacing: 0.12em;
		color: var(--sky);
		margin-right: 10px;
	}
	.counter b {
		font-weight: 500;
	}
	.arrow {
		width: 46px;
		height: 46px;
		border-radius: 50%;
		border: 1px solid #ffffff2e;
		background: #ffffff0a;
		color: var(--ink);
		font-size: 1.1rem;
		cursor: pointer;
	}
	.arrow:hover {
		border-color: var(--sky);
	}
	.carousel {
		display: flex;
		gap: 24px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		padding: 8px max(20px, calc((100vw - var(--maxw)) / 2 + 20px)) 8px;
		scroll-padding: 0 max(20px, calc((100vw - var(--maxw)) / 2 + 20px));
		outline: none;
	}
	.carousel::-webkit-scrollbar {
		display: none;
	}
	.lieu {
		flex: 0 0 min(560px, 84vw);
		scroll-snap-align: start;
	}
	.lieu-img {
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid #8ec5ff40;
		box-shadow: 0 30px 60px -30px #000, 0 0 0 1px #ffffff08 inset;
		margin-bottom: 26px;
		aspect-ratio: 948 / 736;
		background: var(--bg-2);
	}
	.lieu-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s;
	}
	.lieu:hover .lieu-img img {
		transform: scale(1.03);
	}
	.lieu h3 {
		font-size: clamp(1.8rem, 3vw, 2.4rem);
	}
	.lieu p {
		color: var(--ink-dim);
		margin: 0;
		font-size: 1.08rem;
	}
	.dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-top: 36px;
	}
	.dots span {
		width: 8px;
		height: 8px;
		border-radius: 8px;
		background: #ffffff33;
		transition: width 0.3s, background 0.3s;
	}
	.dots span.on {
		width: 32px;
		background: var(--sky);
	}

	/* split */
	.split {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 60px;
		align-items: center;
	}
	@media (max-width: 860px) {
		.split {
			grid-template-columns: 1fr;
			gap: 36px;
		}
	}
	.split-img {
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid #8ec5ff40;
		max-height: 620px;
	}
	.split-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.ticks {
		list-style: none;
		padding: 0;
		margin: 26px 0 0;
	}
	.ticks li {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 7px 0;
	}
	.dot-online {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--online);
		box-shadow: 0 0 10px var(--online);
		flex: none;
	}

	/* wide */
	.wide {
		position: relative;
		border-radius: 28px;
		overflow: hidden;
		border: 1px solid #8ec5ff30;
	}
	.wide img {
		width: 100%;
		height: clamp(420px, 60vw, 640px);
		object-fit: cover;
		object-position: 50% 0%;
	}
	.wide::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 25%, #2f2a9ed9 62%, #2a2790 92%);
	}
	.wide-text {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		padding: 40px;
	}
	@media (max-width: 600px) {
		.wide-text {
			padding: 24px 20px;
		}
	}
	.wide-text p {
		color: #d6deea;
		margin: 0;
		max-width: 560px;
	}

	/* étapes */
	.steps {
		list-style: none;
		padding: 0;
		margin: 44px 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
	}
	.step {
		background: linear-gradient(180deg, #ffffff26, #ffffff0d);
		backdrop-filter: blur(14px);
		box-shadow: 0 20px 50px -30px #1a1660;
		border: 1px solid #ffffff38;
		border-radius: var(--radius);
		padding: 28px 26px;
	}
	.step-n {
		display: inline-block;
		font-size: 1.2rem;
		letter-spacing: 0.12em;
		color: var(--sky);
		margin-bottom: 18px;
	}
	.step h3 {
		font-size: 1.4rem;
	}
	.step p {
		color: var(--ink-dim);
		margin: 0;
	}

	/* faq */
	.faq-wrap {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 40px;
	}
	@media (max-width: 860px) {
		.faq-wrap {
			grid-template-columns: 1fr;
		}
	}
	.faq details {
		border-bottom: 1px solid var(--line);
		padding: 20px 0;
	}
	.faq summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 1.08rem;
		list-style: none;
		display: flex;
		justify-content: space-between;
		gap: 16px;
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq summary::after {
		content: '+';
		color: var(--sky);
		font-size: 1.3rem;
		line-height: 1;
	}
	.faq details[open] summary::after {
		content: '–';
	}
	.faq p {
		color: var(--ink-dim);
		margin: 10px 0 0;
	}

	/* final */
	.final {
		background: radial-gradient(circle at 50% 38%, #ff8fc4 0%, #b45fd6 24%, #5b4ee6 52%, #3346e0 82%);
		position: relative;
		border-radius: 28px;
		overflow: hidden;
		border: 1px solid #8ec5ff30;
		min-height: 560px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	.final .rings {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(900px, 160%);
		aspect-ratio: 1;
		translate: -50% -50%;
		z-index: 1;
		fill: none;
		pointer-events: none;
	}
	.final .rings circle {
		stroke: #fff;
		transform-origin: 500px 500px;
	}
	.final .r1 {
		stroke-opacity: 0.25;
		stroke-width: 2;
		stroke-dasharray: 3 16;
		animation: ringSpin 40s linear infinite;
	}
	.final .r2 {
		stroke-opacity: 0.4;
		stroke-width: 3;
		stroke-dasharray: 200 50 14 50;
		animation: ringSpin 22s linear infinite reverse;
	}
	.final .r3 {
		stroke: #ff5fa2;
		stroke-opacity: 0.7;
		stroke-width: 4;
		stroke-dasharray: 100 400;
		animation: ringSpin 7s linear infinite;
	}
	@keyframes ringSpin {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.final .rings circle {
			animation: none;
		}
	}
	.final > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
	}
	.final::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 45%, #ff8fc4aa 0%, #b45fd688 25%, transparent 60%);
	}
	.final-text {
		position: relative;
		z-index: 1;
		padding: 48px 24px;
		display: flex;
		flex-direction: column;
